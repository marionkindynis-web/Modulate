# Public site URL (sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://modulate.ch

# Coming soon page (default: on). Set to false to reveal the full site.
NEXT_PUBLIC_COMING_SOON=true

# SMTP Infomaniak — configure in the Infomaniak Manager, not in Git
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Mailbox that receives contact and quote form submissions
CONTACT_TO_EMAIL=

# Optional From header (defaults to SMTP_USER)
SMTP_FROM=

